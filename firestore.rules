rules_version = '2';

// ============================================================
// Firestore Security Rules — ARCHIMAX (Food n Beverages Lifestyle
// Accounting). Ditulis untuk Spark Plan: TIDAK ada Cloud Functions/
// custom claims, jadi peran (role) dibaca langsung dari dokumen
// users/{uid} setiap kali dicek (via get()).
//
// MULTI-CABANG (revisi permintaan pemilik cafe: "Finance juga
// terpusat login pilih outlet"): Owner (peran "superadmin") DAN
// Finance SAMA-SAMA terpusat — satu akun mengakses SEMUA Outlet,
// tidak py outletId tetap. HANYA Kasir/Purchasing yang masing-masing
// TERTAUT ke SATU Outlet tetap (field `outletId` di users/{uid},
// ditentukan Owner/Finance saat akun dibuat di Kelola Akun — tidak
// bisa diubah sendiri, lihat aturan `users` di bawah).
//
// SELURUH data operasional (menu, bahan baku, shift, kas, saldo
// finance, dst — semua yang dulunya koleksi top-level) sekarang
// hidup di bawah SUB-KOLEKSI per Outlet: `outlets/{outletId}/...`.
// Ini SENGAJA dipilih (bukan sekadar field `outletId` di koleksi
// lama) supaya isolasi antar Outlet ditentukan oleh LOKASI/PATH data
// itu sendiri, bukan field yang secara teori bisa saja salah/
// dipalsukan klien — jauh lebih aman & lebih sederhana dicerna di
// setiap match di bawah (tinggal bandingkan `outletId` dari path
// dengan outletId akun, bukan `resource.data.outletId`).
//
// SRASA BOOK adalah Outlet PERTAMA (dokumen di koleksi top-level
// `outlets`) — bukan lagi nama aplikasi (lihat README).
//
// Data menu SUDAH DIPECAH jadi dua koleksi terpisah dengan menuId
// yang sama: `menu_harga` (nama, kategori, harga jual — boleh dibaca
// Kasir) dan `menu` (HPP, resep, margin — khusus Owner/Finance
// outlet itu). Ini menutup celah yang sebelumnya ada saat harga dan
// HPP masih tercampur di satu dokumen — Security Rules bekerja di
// level dokumen, jadi pemisahan fisik ini yang benar-benar
// menegakkan kerahasiaan, bukan sekadar menyembunyikannya di UI.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // SECTION: Helper functions
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().aktif == true;
    }

    function role() {
      return userDoc().peran;
    }

    /** Outlet TETAP milik akun ini — HANYA berarti untuk Kasir/
     *  Purchasing sejak revisi "Finance juga terpusat". Owner DAN
     *  Finance tidak punya nilai berarti di sini — keduanya
     *  ditentukan lewat isOwner()/isFinance(), bukan pencocokan
     *  outletId. */
    function myOutletId() {
      return userDoc().outletId;
    }

    /** Owner (superadmin) — satu akun terpusat untuk SEMUA Outlet. */
    function isOwner() {
      return isActiveUser() && role() == 'superadmin';
    }

    /** Finance — SEJAK REVISI "Finance juga terpusat login pilih
     *  outlet", Finance SAMA seperti Owner: satu akun terpusat untuk
     *  SEMUA Outlet, TIDAK terikat outletId tetap. Satu-satunya beda
     *  dari Owner tetap dipertahankan di bawah (lihat SECTION
     *  saldo_finance/transaksi_finance): Finance yang mengeksekusi
     *  Uang Masuk/Keluar Saldo Deposito, bukan Owner. */
    function isFinance() {
      return isActiveUser() && role() == 'finance';
    }

    function isKasir() {
      return isActiveUser() && role() == 'kasir';
    }

    function isPurchasing() {
      return isActiveUser() && role() == 'purchasing';
    }

    /** Alias historis — SEJAK Finance terpusat (tidak py outletId
     *  tetap), ini identik dengan isFinance() dan mengabaikan
     *  `outletId` yang dioper. Dipertahankan (bukan dihapus & diganti
     *  satu-satu di seluruh berkas) supaya SEMUA pemanggilan
     *  isFinanceOutlet(outletId) di bawah — yang menyertakan outletId
     *  dari path match, bukan dari akun Finance — tetap benar tanpa
     *  perlu disentuh satu per satu. */
    function isFinanceOutlet(outletId) {
      return isFinance();
    }

    function isKasirOutlet(outletId) {
      return isKasir() && myOutletId() == outletId;
    }

    function isPurchasingOutlet(outletId) {
      return isPurchasing() && myOutletId() == outletId;
    }

    /** "Setara Owner di Outlet manapun" — pengganti isSuperadmin()
     *  versi lama untuk SEMUA data yang sekarang hidup di bawah
     *  outlets/{outletId}/... Owner DAN Finance SELALU lolos di
     *  outlet manapun (keduanya terpusat) — parameter outletId
     *  dipertahankan untuk konsistensi pemanggilan, bukan dipakai
     *  langsung di sini lagi. */
    function isManagerOutlet(outletId) {
      return isOwner() || isFinanceOutlet(outletId);
    }

    // ------------------------------------------------------------
    // SECTION: users — profil, peran & Outlet tetap setiap akun
    // (GLOBAL, TIDAK di bawah outlets/{outletId} — dibutuhkan untuk
    // resolusi peran/Outlet SEBELUM tahu sedang membuka Outlet mana).
    // Owner DAN Finance (KEDUANYA terpusat, revisi: "Finance juga
    // terpusat login pilih outlet") sama-sama boleh membuat/mengubah
    // akun untuk Outlet MANAPUN — tidak ada lagi pembatasan
    // resource.data.outletId == myOutletId() untuk Finance, karena
    // Finance sendiri tidak lagi punya outletId tetap (Kelola Akun,
    // PRD 9.7: staff — Kasir/Purchasing — tidak mendaftar sendiri).
    // ------------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isOwner() || isFinance());
      allow list: if isOwner() || isFinance();
      allow create: if (isOwner() || isFinance())
        && request.resource.data.peran in ['kasir', 'purchasing', 'finance'];
      allow update, delete: if isOwner() || isFinance();

      // Halaman Profil Akun: setiap orang boleh memperbaiki NAMA-nya
      // sendiri (salah ketik saat akun dibuat, dsb).
      //
      // Dibatasi hasOnly(['nama']) dan BUKAN sekadar "boleh ubah
      // dokumen sendiri" — ini bedanya krusial: kalau `peran` ATAU
      // `outletId` ikut boleh berubah, Kasir bisa menaikkan dirinya
      // sendiri jadi superadmin ATAU memindahkan dirinya ke Outlet
      // lain hanya lewat devtools browser, dan SELURUH matriks hak
      // akses & isolasi antar-Outlet di berkas ini jadi tidak
      // berarti. `aktif` juga ditahan, supaya akun yang dinonaktifkan
      // tidak bisa menghidupkan dirinya kembali.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nama"]);
    }

    // ------------------------------------------------------------
    // SECTION: usernames — pemetaan "username publik" -> email asli,
    // KHUSUS supaya Login bisa menerima Username selain Email (PRD
    // 9.7 lanjutan). GLOBAL (lintas Outlet) karena Login terjadi
    // SEBELUM tahu Outlet mana pun. Firebase Auth sendiri TIDAK PUNYA
    // konsep username, hanya email/password — jadi halaman Login
    // membaca dokumen ini DULU (sebelum request.auth ada sama
    // sekali) untuk menerjemahkan username -> email.
    //
    // Isinya SENGAJA minimal (cuma uid + email) supaya aman dibaca
    // publik. Ditulis bersamaan saat akun staff baru dibuat di Kelola
    // Akun (Owner ATAU Finance outlet manapun boleh — usernames
    // sendiri tidak membocorkan Outlet apa pun, keamanan sungguhan
    // ada di rules `users` di atas).
    // ------------------------------------------------------------

    match /usernames/{username} {
      allow read: if true;
      allow write: if isOwner() || isFinance();
    }

    // ------------------------------------------------------------
    // SECTION: outlets — daftar Outlet (Cabang). GLOBAL, TOP-LEVEL —
    // struktur ini hidup DI ATAS seluruh data per-Outlet lainnya.
    // Semua peran aktif boleh BACA (staff perlu tahu nama Outletnya
    // sendiri untuk header/ekspor; Owner & Finance perlu daftar
    // lengkap untuk layar Pilih Outlet & pengalih Outlet, keduanya
    // terpusat). Hanya Owner MURNI yang menulis (tambah/nonaktifkan
    // Outlet) — ini keputusan struktural lintas-Outlet, BUKAN
    // wewenang Finance walau Finance kini setara Owner di hampir
    // semua data operasional (lihat isManagerOutlet()).
    // ------------------------------------------------------------

    match /outlets/{outletId} {
      allow read: if isActiveUser();
      allow write: if isOwner();

      // --------------------------------------------------------
      // SECTION: MODE DEMO — Outlet percobaan ber-ID tetap
      // "demo_archimax" (lihat src/shared/lib/mode-demo.ts). SELURUH
      // isinya boleh dibaca, ditulis, dan dihapus SEMUA akun aktif
      // (peran apa pun) — itulah yang membuat Mode Demo "bebas
      // otak-atik & bebas reset". Aturan Firestore bersifat OR: blok
      // ini HANYA menambah izin untuk path demo_archimax, dan sama
      // sekali TIDAK melonggarkan aturan Outlet asli di bawah (kondisi
      // outletId == 'demo_archimax' tidak pernah benar untuk Outlet
      // asli, yang ID-nya selalu acak dari addDoc).
      // --------------------------------------------------------
      match /{dokumenDemo=**} {
        allow read, write: if outletId == 'demo_archimax' && isActiveUser();
      }

      // --------------------------------------------------------
      // SECTION: bahan_baku — inventaris & harga bahan (per Outlet)
      // --------------------------------------------------------

      match /bahan_baku/{bahanId} {
        allow read, write: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);

        // Kasir TIDAK BOLEH baca bahan_baku sama sekali (harga tetap
        // rahasia), tapi Resep butuh stok gudang otomatis berkurang
        // saat Kasir mencatat penjualan. Izin ini SENGAJA hanya
        // "update", dibatasi hanya field `stokSaatIni` (pola "tulis
        // tanpa baca").
        allow update: if isKasirOutlet(outletId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stokSaatIni"]);

        match /riwayat_harga/{riwayatId} {
          allow read: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
          allow create: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
          allow update, delete: if isManagerOutlet(outletId);
        }

        match /penyesuaian_stok/{penyesuaianId} {
          allow read: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
          allow create: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
          allow update, delete: if isManagerOutlet(outletId);
        }
      }

      // --------------------------------------------------------
      // SECTION: stok_kasir — CERMIN bahan_baku TANPA harga (per Outlet)
      // --------------------------------------------------------

      match /stok_kasir/{bahanId} {
        allow read: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId) || isKasirOutlet(outletId);
        allow create, update, delete: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
        allow update: if isKasirOutlet(outletId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stokSaatIni"]);
      }

      // --------------------------------------------------------
      // SECTION: menu_harga — nama, kategori, harga jual (PUBLIK di
      // dalam Outlet). menu — HPP, resep, margin (PRIVAT).
      // --------------------------------------------------------

      match /menu_harga/{menuId} {
        allow read: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
        allow write: if isManagerOutlet(outletId);

        match /varian/{varianId} {
          allow read: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
          allow write: if isManagerOutlet(outletId);
        }
      }

      match /menu/{menuId} {
        allow read, write: if isManagerOutlet(outletId);

        match /varian/{varianId} {
          allow read, write: if isManagerOutlet(outletId);
        }

        // Resep (bahan + takaran) SENGAJA boleh dibaca Kasir juga —
        // isinya cuma bahanId + takaran + satuan, TIDAK ADA Rupiah.
        match /resep/{resepId} {
          allow read: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
          allow write: if isManagerOutlet(outletId);
        }

        match /biaya_tambahan/{biayaId} {
          allow read, write: if isManagerOutlet(outletId);
        }
      }

      // --------------------------------------------------------
      // SECTION: shift — buka/tutup shift, penjualan, kas keluar
      // (per Outlet). Kasir hanya boleh baca/ubah shift MILIKNYA
      // SENDIRI dan hanya selagi belum terkunci.
      // --------------------------------------------------------

      match /shift/{shiftId} {
        allow read: if isManagerOutlet(outletId)
          || (isKasirOutlet(outletId) && resource.data.kasirUid == request.auth.uid);
        allow create: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
        allow update: if isManagerOutlet(outletId)
          || (isKasirOutlet(outletId)
              && resource.data.kasirUid == request.auth.uid
              && resource.data.status != 'terkunci');
        allow delete: if isManagerOutlet(outletId);

        match /penjualan/{itemId} {
          allow read: if isManagerOutlet(outletId)
            || (isKasirOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.kasirUid == request.auth.uid);
          allow create, update: if isManagerOutlet(outletId)
            || (isKasirOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.kasirUid == request.auth.uid
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.status != 'terkunci');
          allow delete: if isManagerOutlet(outletId);
        }

        match /kas_keluar/{kasKeluarId} {
          allow read: if isManagerOutlet(outletId)
            || (isKasirOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.kasirUid == request.auth.uid);
          allow create, update: if isManagerOutlet(outletId)
            || (isKasirOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.kasirUid == request.auth.uid
                && get(/databases/$(database)/documents/outlets/$(outletId)/shift/$(shiftId)).data.status != 'terkunci');
          allow delete: if isManagerOutlet(outletId);
        }
      }

      // --------------------------------------------------------
      // SECTION: kas_belanja — belanja harian & nota (per Outlet)
      // --------------------------------------------------------

      match /kas_belanja/{belanjaId} {
        allow read: if isManagerOutlet(outletId)
          || (isPurchasingOutlet(outletId) && resource.data.purchasingUid == request.auth.uid);
        allow create: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
        allow update: if isManagerOutlet(outletId)
          || (isPurchasingOutlet(outletId)
              && resource.data.purchasingUid == request.auth.uid
              && resource.data.status != 'terkunci');
        allow delete: if isManagerOutlet(outletId);

        match /item/{itemId} {
          allow read: if isManagerOutlet(outletId)
            || (isPurchasingOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/kas_belanja/$(belanjaId)).data.purchasingUid == request.auth.uid);
          allow create, update: if isManagerOutlet(outletId)
            || (isPurchasingOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/kas_belanja/$(belanjaId)).data.purchasingUid == request.auth.uid
                && get(/databases/$(database)/documents/outlets/$(outletId)/kas_belanja/$(belanjaId)).data.status != 'terkunci');
          allow delete: if isManagerOutlet(outletId);
        }

        match /nota/{notaId} {
          allow read: if isManagerOutlet(outletId)
            || (isPurchasingOutlet(outletId)
                && get(/databases/$(database)/documents/outlets/$(outletId)/kas_belanja/$(belanjaId)).data.purchasingUid == request.auth.uid);
          allow create: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
          allow update, delete: if isManagerOutlet(outletId);
        }
      }

      // --------------------------------------------------------
      // SECTION: summary_harian & summary_bulanan — dasar Dashboard
      // (per Outlet). Owner/Finance outlet ini untuk BACA; Kasir &
      // Purchasing outlet ini tetap diberi izin TULIS (update saja)
      // supaya klien mereka bisa memutakhirkan lewat increment() saat
      // tutup shift/nota disimpan, TANPA perlu membaca dokumennya
      // lebih dulu ("tulis tanpa baca").
      // --------------------------------------------------------

      match /summary_harian/{tanggal} {
        allow read: if isManagerOutlet(outletId);
        allow write: if isManagerOutlet(outletId) || isKasirOutlet(outletId) || isPurchasingOutlet(outletId);
      }

      match /summary_bulanan/{bulan} {
        allow read: if isManagerOutlet(outletId);
        allow write: if isManagerOutlet(outletId) || isKasirOutlet(outletId) || isPurchasingOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: tiket_approval — pengajuan koreksi data terkunci
      // (per Outlet)
      // --------------------------------------------------------

      match /tiket_approval/{tiketId} {
        allow read: if isManagerOutlet(outletId)
          || (myOutletId() == outletId && resource.data.diajukanOlehUid == request.auth.uid);
        allow create: if isActiveUser()
          && myOutletId() == outletId
          && request.resource.data.diajukanOlehUid == request.auth.uid
          && request.resource.data.status == 'menunggu';
        allow update, delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: profil_cafe — Detail Perusahaan/KOP surat (per Outlet)
      // --------------------------------------------------------

      match /profil_cafe/{cafeId} {
        allow read: if isActiveUser() && (isOwner() || isFinance() || myOutletId() == outletId);
        allow write: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: notifikasi — Pusat Notifikasi (per Outlet, lintas peran
      // DI DALAM Outlet itu)
      // --------------------------------------------------------

      match /notifikasi/{notifId} {
        allow read: if isActiveUser()
          && (isOwner() || isFinance() || myOutletId() == outletId)
          && (resource.data.untukUid == request.auth.uid || resource.data.untukPeran == role());
        allow create: if isActiveUser() && (isOwner() || isFinance() || myOutletId() == outletId);
        allow update: if isActiveUser() && resource.data.untukUid == request.auth.uid;
        allow delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: tanggungan_kasir — ganti rugi selisih kas (per Outlet)
      // --------------------------------------------------------

      match /tanggungan_kasir/{tanggunganId} {
        allow read: if isManagerOutlet(outletId)
          || (isKasirOutlet(outletId) && resource.data.kasirUid == request.auth.uid);
        // Owner/Finance JUGA boleh membuat dokumen ini (bukan cuma Kasir
        // sendiri) — dibutuhkan untuk fitur "Tutup Paksa Shift" di
        // Riwayat: Owner/Finance menutup shift yang tersangkut terbuka
        // (mis. Kasir-nya sudah dinonaktifkan) atas nama Kasir ASLI yang
        // tercatat di shift itu, bukan atas nama Owner/Finance sendiri —
        // makanya tidak disyaratkan kasirUid == request.auth.uid untuk
        // jalur admin ini.
        allow create: if (isKasirOutlet(outletId) && request.resource.data.kasirUid == request.auth.uid)
          || isManagerOutlet(outletId);
        allow update, delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: banding_purchasing — form banding/revisi Purchasing
      // (per Outlet). Analog tanggungan_kasir (ganti rugi Kasir), tapi
      // untuk sisi Purchasing: nota salah catat, transaksi belanja yang
      // belum tercatat, atau insiden lain yang menyebabkan Cash Opname
      // Akhir Hari tidak balance. Purchasing MENGAJUKAN, Owner/Finance
      // MENINJAU (setuju/tolak) — atas permintaan pemilik cafe: "Form
      // Banding Revisi Purchasing atau Banding transaksi belum
      // tercatat, atau insiden".
      // --------------------------------------------------------

      match /banding_purchasing/{bandingId} {
        allow read: if isManagerOutlet(outletId)
          || (isPurchasingOutlet(outletId) && resource.data.purchasingUid == request.auth.uid);
        allow create: if (isPurchasingOutlet(outletId) && request.resource.data.purchasingUid == request.auth.uid)
          || isManagerOutlet(outletId);
        // Update HANYA untuk Owner/Finance meninjau (status/catatanReview)
        // — Purchasing tidak boleh mengubah pengajuannya sendiri setelah
        // dikirim (harus ajukan baru kalau salah ketik), supaya jejak
        // pengajuan tetap utuh untuk audit.
        allow update, delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: hutang_supplier — Hutang Usaha ke Supplier (per
      // Outlet). Dicatat Purchasing saat sebuah Nota dibayar BELAKANGAN
      // (supplier titip barang dulu, dibayar di akhir/termin) — atas
      // pertanyaan pemilik cafe: "apakah piutang/hutang supplier bisa
      // masuk Neraca?" (lihat NeracaFinanceKartu di dashboard/page.tsx,
      // ditampilkan sebagai Kewajiban). SENGAJA TIDAK menyentuh
      // kas_belanja/saldo_finance sama sekali saat dibuat — murni
      // pencatatan tambahan untuk Neraca, bukan menulis ulang alur kas
      // sesi belanja yang sudah ada (supaya tidak berisiko merusak
      // Cash Opname/ekspor yang sudah teruji).
      // --------------------------------------------------------

      match /hutang_supplier/{hutangId} {
        allow read: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
        allow create: if isPurchasingOutlet(outletId)
          && request.resource.data.purchasingUid == request.auth.uid
          && request.resource.data.nominal > 0;
        // Pelunasan: atas permintaan pemilik cafe, BAIK Finance/Owner
        // MAUPUN Purchasing boleh menandai lunas ("siapa pun yang lebih
        // dulu tahu pembayaran terjadi") — dibatasi hasOnly supaya field
        // lain (nominal, namaSupplier, dst) tidak bisa diubah lagi
        // setelah dibuat, dan status hanya boleh berubah MENJADI "lunas"
        // lewat jalur ini (bukan dikembalikan ke belum_lunas — kalau
        // salah tandai, Owner/Finance koreksi lewat delete+catat ulang).
        allow update: if (isManagerOutlet(outletId) || isPurchasingOutlet(outletId))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "dilunasiOlehUid", "dilunasiOlehNama", "waktuLunas"])
          && request.resource.data.status == "lunas";
        allow delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: nota_refund — refund lintas hari/shift (per Outlet)
      // --------------------------------------------------------

      match /nota_refund/{refundId} {
        allow read: if isManagerOutlet(outletId)
          || (isKasirOutlet(outletId) && resource.data.kasirUid == request.auth.uid);
        allow create: if isKasirOutlet(outletId) && request.resource.data.kasirUid == request.auth.uid;
        allow update, delete: if isManagerOutlet(outletId);
      }

      // Penghitung qty Nota Refund per shift+menu (perbaikan bug over-
      // refund race — lihat komentar runTransaction() di
      // src/app/refund/page.tsx). Hanya berisi qty, tidak ada Rupiah/
      // harga, jadi aman dibaca Kasir juga.
      match /nota_refund_counter/{counterId} {
        allow read, write: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: saldo_finance & transaksi_finance — Deposito
      // Finance (per Outlet). NUANSA AKSES KHUSUS (beda dari seluruh
      // rules lain di berkas ini, TETAP DIPERTAHANKAN walau Finance
      // sekarang terpusat seperti Owner): di Outlet manapun, Owner
      // SENGAJA hanya boleh MEMBACA/memantau saldo & riwayat (plus
      // admin override update saldo untuk koreksi data, lihat di
      // bawah), TIDAK BOLEH mencatat transaksi/menjadi pelaksana Uang
      // Masuk-Keluar sehari-hari (permintaan eksplisit pemilik cafe:
      // "Owner tidak bisa") — itulah kenapa create transaksi & update/
      // delete transaksi di sini memakai isFinanceOutlet() (=
      // isFinance(), lihat helper di atas) sendirian, BUKAN
      // isManagerOutlet().
      // --------------------------------------------------------

      match /saldo_finance/{dokId} {
        // Purchasing outlet ini SENGAJA diberi baca (bukan Kasir) —
        // perlu tahu sisa saldo sebelum memilih "Saldo Finance" saat
        // "Mulai Belanja".
        allow read: if isManagerOutlet(outletId) || isPurchasingOutlet(outletId);
        allow create: if isOwner() || isFinanceOutlet(outletId);

        // Purchasing outlet ini HANYA boleh MENGURANGI saldo (lewat
        // increment negatif), TIDAK PERNAH field lain. Finance outlet
        // ini boleh menambah ATAU mengurangi.
        //
        // CATATAN (revisi permintaan pemilik cafe): saldo Deposito
        // Finance SENGAJA DIIZINKAN MINUS untuk Finance & Purchasing
        // juga (dulu wajib >= 0 di sini) — prinsip akuntansi: saldo
        // harus mencerminkan kondisi nyata biarpun negatif (mis. dana
        // sudah dikeluarkan/dipakai duluan sebelum setoran Owner
        // berikutnya masuk), bukan dipaksa berhenti di 0. Owner (admin
        // override) TETAP bebas mengubah field apa pun tanpa batas
        // (isOwner() berdiri sendiri, TIDAK ikut batasan hasOnly di
        // bawah) — hanya baris saldo>=0 yang dihapus dari jalur
        // Finance/Purchasing.
        // Finance boleh menambah ATAU mengurangi (Tambah Dana, Catat
        // Transaksi Keluar, Tandai Lunas Hutang). Purchasing HANYA
        // boleh MENGURANGI (Mulai Belanja sumber Saldo Finance, Tandai
        // Lunas Hutang) — `saldo` baru WAJIB lebih kecil dari sebelumnya,
        // supaya tidak ada jalur bagi Purchasing untuk menambah saldo
        // sendiri di luar alur "Tambah Dana" milik Finance.
        allow update: if isOwner()
          || (isFinanceOutlet(outletId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["saldo"]))
          || (isPurchasingOutlet(outletId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["saldo"])
              && request.resource.data.saldo < resource.data.saldo);
      }

      match /transaksi_finance/{transaksiId} {
        allow read: if isManagerOutlet(outletId);
        allow create: if isFinanceOutlet(outletId)
          && request.resource.data.financeUid == request.auth.uid
          && request.resource.data.nominal > 0;
        // SENGAJA isFinanceOutlet() saja (bukan isManagerOutlet()) —
        // koreksi/hapus transaksi Deposito Finance juga "uang masuk/
        // keluar" yang tidak boleh dieksekusi Owner.
        allow update, delete: if isFinanceOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: slot_shift — Jadwal Shift (per Outlet). Domain
      // PENJADWALAN, bukan uang masuk/keluar, jadi Owner & Finance
      // outlet ini sama-sama boleh kelola (isManagerOutlet biasa).
      // --------------------------------------------------------

      match /slot_shift/{slotId} {
        allow read: if isActiveUser() && (isOwner() || isFinance() || myOutletId() == outletId);
        allow write: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: serah_terima_kas — audit serah terima kas fisik
      // antar Kasir (per Outlet). SENGAJA TIDAK ditargetkan ke uid
      // penerima tertentu — Kasir tidak punya akses `list` ke
      // koleksi users untuk memilih nama, jadi SEMUA Kasir outlet ini
      // boleh membaca daftar hari ini.
      // --------------------------------------------------------

      match /serah_terima_kas/{id} {
        allow read: if isManagerOutlet(outletId) || isKasirOutlet(outletId);
        allow create: if isKasirOutlet(outletId) && request.resource.data.dariUid == request.auth.uid;
        allow update, delete: if isManagerOutlet(outletId);
      }

      // --------------------------------------------------------
      // SECTION: catatan_owner & backup_log — setara Owner Outlet ini
      // --------------------------------------------------------

      match /catatan_owner/{catatanId} {
        allow read, write: if isManagerOutlet(outletId);
      }

      match /backup_log/{logId} {
        allow read, write: if isManagerOutlet(outletId);
      }
    }

    // ------------------------------------------------------------
    // SECTION: Jaring pengaman — apa pun yang tidak disebut di atas
    // otomatis tertolak, sama seperti rules default Firebase.
    // ------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
